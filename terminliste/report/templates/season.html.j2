<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  /* Global: the page's own `display` rules (grids, flex rows) would otherwise win over the hidden attribute. */
  [hidden] { display: none !important; }
  :root {
    --bg: #f7f7f5;
    --panel: #ffffff;
    --ink: #1c1c1a;
    --muted: #6b6b66;
    --line: #e0e0da;
    --good: #1e8449;
    --bad: #c0392b;
    --warn: #b9770e;
    --accent: #2471a3;
    /* Text in the cost colour: --warn stays for edges, this one clears 4.5:1 on the panel and page. */
    --warn-ink: #94620a;
    --panel-pad: 24px;
  }
  * { box-sizing: border-box; }
  /* `hidden` on <html> alone is taken by the viewport; on <body> too it would become a scroll container and break the sticky bar, hence `clip` there. */
  html { overflow-x: hidden; }
  body { overflow-x: clip; }
  /* --bar-h is the sticky controls bar's height, kept current by report.js, so every scroll target clears it. */
  html { --bar-h: 0px; scroll-padding-top: calc(var(--bar-h) + 8px); }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 32px 20px 80px; }
  header h1 { margin: 0 0 4px; font-size: 26px; letter-spacing: -0.01em; }
  header .sub { color: var(--muted); font-size: 14px; }
  .notes {
    margin: 16px 0 0; padding: 12px 14px; border-left: 3px solid var(--bad);
    background: #fdf0ee; font-size: 14px;
  }
  .warnings {
    margin: 16px 0 0; padding: 12px 14px; border-left: 3px solid var(--warn);
    background: #fdf6ea; font-size: 14px;
  }
  .warnings div { margin: 2px 0; }
  .hardbox {
    margin-top: 22px; padding: 16px 18px; border-radius: 8px;
    border: 1px solid #f2c6c0; background: #fdf4f3;
  }
  .hardbox h3 { margin: 0 0 10px; font-size: 14px; color: var(--bad); text-transform: uppercase; letter-spacing: 0.05em; }
  .hardbox .item { border-left-color: var(--bad); }

  /* -- option tabs -- */
  .tabs { display: flex; gap: 6px; margin: 28px 0 0; flex-wrap: wrap; }
  .tab {
    border: 1px solid var(--line); background: var(--panel); color: var(--ink);
    padding: 9px 16px; border-radius: 7px 7px 0 0; cursor: pointer;
    font-size: 14px; font-weight: 600; border-bottom: none;
  }
  .tab .score { color: var(--muted); font-weight: 400; margin-left: 8px; }
  .tab .tab-seed { color: var(--muted); font-weight: 400; font-size: 12px; margin-left: 8px; }
  .tab .tab-tag, .cmp-tag {
    display: inline-block; font-size: 10.5px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.04em; padding: 1px 7px; border-radius: 9px; margin-left: 8px;
    background: #e8f6ee; color: #14653a; white-space: nowrap;
  }
  .tab[aria-selected="true"] { background: var(--ink); color: #fff; }
  .tab[aria-selected="true"] .score { color: #c9c9c4; }
  .tab[aria-selected="true"] .tab-seed { color: #c9c9c4; }
  .tab[aria-selected="true"] .tab-tag { background: #ffffff; color: #14653a; }

  /* -- comparing the options (#35): a table of what each option scores per rule -- */
  .compare { margin: 28px 0 0; }
  .compare h2 { margin: 0; font-size: 18px; letter-spacing: -0.01em; }
  .compare .desc { margin: 4px 0 0; }
  .cmp-wrap {
    margin-top: 12px; border: 1px solid var(--line); border-radius: 8px;
    background: var(--panel); overflow-x: auto;
  }
  table.cmp { margin: 0; font-size: 14px; }
  .cmp th, .cmp td { padding: 9px 12px; border-bottom: 1px solid var(--line); }
  .cmp thead th {
    text-transform: none; letter-spacing: 0; font-size: 14px; color: var(--ink);
    font-weight: 700; vertical-align: top; background: var(--panel);
  }
  .cmp-measure { width: 30%; text-transform: none; letter-spacing: 0; font-size: 14px; color: var(--ink); font-weight: 500; }
  .cmp-open {
    border: 0; background: none; padding: 0; color: var(--ink); font: inherit; font-weight: 700;
    text-decoration: underline; text-underline-offset: 3px; cursor: pointer;
  }
  .cmp-seed { color: var(--muted); font-size: 12px; font-weight: 400; margin-left: 6px; white-space: nowrap; }
  .cmp .cmp-tag { white-space: normal; margin: 4px 0 0; }
  .cmp-what {
    margin-top: 6px; font-size: 12.5px; font-weight: 400; color: var(--muted); line-height: 1.4;
    text-transform: none; letter-spacing: 0;
  }
  .cmp tbody + tbody tr:first-child th { border-top: 1px solid var(--line); }
  .cmp tr.cmp-section th {
    background: #fafaf8; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--muted); font-weight: 700; padding: 6px 12px;
  }
  .cmp td.cmp-cell { text-align: right; font-variant-numeric: tabular-nums; }
  .cmp-val { font-weight: 500; }
  .cmp-sub { display: block; font-size: 12px; color: var(--muted); }
  .cmp-best {
    display: inline-block; margin-left: 6px; font-size: 10.5px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em; color: #14653a; white-space: nowrap;
  }
  .cmp td.is-best { background: #e8f6ee; }
  .cmp td.is-best .cmp-val { font-weight: 800; }
  .cmp-tag-short { display: none; }
  /* Phones: the summaries move out of the narrow header cells into a list under the table. */
  @media (max-width: 480px) {
    .cmp th, .cmp td { padding: 8px 6px; }
    .cmp-measure { width: 34%; }
    .cmp .cmp-what { display: none; }
    .cmp-tag-long { display: none; }
    .cmp-tag-short { display: inline; }
    .cmp .cmp-tag { white-space: nowrap; }
    .cmp-phone-summary { display: block; margin: 12px 0 0; padding-left: 18px; font-size: 13.5px; }
    .cmp-phone-summary li { margin: 4px 0; }
  }
  .cmp-quiet { margin: 10px 0 0; }
  @media (min-width: 481px) { .cmp-phone-summary { display: none; } }
  .cmp-diffs { margin-top: 12px; }
  .cmp-diff { margin-top: 6px; }
  .cmp-diff summary { font-size: 14px; }
  .cmp-list { margin: 6px 0 0; padding-left: 18px; font-size: 13.5px; }
  .cmp-list li { margin: 2px 0; }
  .cmp-date { color: var(--muted); font-variant-numeric: tabular-nums; margin-right: 4px; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
  .panel {
    background: var(--panel); border: 1px solid var(--line);
    border-radius: 0 8px 8px 8px; padding: var(--panel-pad);
  }
  .panel[hidden] { display: none; }

  /* -- score header -- */
  .scoreline { display: flex; align-items: baseline; gap: 20px; flex-wrap: wrap; }
  .total { font-size: 34px; font-weight: 700; letter-spacing: -0.02em; }
  .total small { font-size: 13px; font-weight: 400; color: var(--muted); margin-left: 6px; }
  .badge {
    font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 20px;
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .badge.ok { background: #e4f3ea; color: var(--good); }
  .badge.fail { background: #fbe6e3; color: var(--bad); }

  .headlines { display: flex; gap: 28px; margin: 20px 0 4px; flex-wrap: wrap; }
  .headline .v { font-size: 24px; font-weight: 700; }
  .headline .l { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }

  /* -- upsides / problems --
     Each entry is a <details> so the per-team occurrence list stays out of
     the way until asked for — collapsed by default, one line of name+delta
     to scan per rule. */
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-top: 26px; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } }
  .col h3 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 10px; color: var(--muted); }
  .item { border-left: 3px solid var(--line); margin-bottom: 10px; }
  /* The hard-violation box below still renders `.item` as a plain <div> (it
     isn't collapsible), so it needs its own padding — the <details> version
     gets padding from summary.top/.item-body instead, further down. */
  .item:not(details) { padding: 8px 0 8px 12px; }
  .item.up { border-left-color: var(--good); }
  .item.down { border-left-color: var(--bad); }
  .item .top { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  details.item > summary.top { cursor: pointer; padding: 8px 8px 8px 4px; list-style: none; }
  details.item > summary.top::-webkit-details-marker { display: none; }
  details.item > summary.top::before {
    content: '▸'; display: inline-block; width: 12px; color: var(--muted);
    font-size: 10px; transition: transform 0.12s ease;
  }
  details.item[open] > summary.top::before { transform: rotate(90deg); }
  details.item > summary.top .name-block { margin-right: auto; min-width: 0; display: flex; flex-direction: column; }
  .rule-desc { color: var(--muted); font-size: 12.5px; line-height: 1.35; margin-top: 2px; }
  .coverage { color: var(--muted); font-size: 12.5px; font-variant-numeric: tabular-nums; margin-top: 1px; }
  .gain-text { color: var(--good); }
  .cost-text { color: var(--bad); }
  .split-bar { display: flex; height: 8px; border-radius: 4px; overflow: hidden; background: #eeeee9; margin: 10px 0 6px; max-width: 480px; }
  .split-gain { display: block; height: 100%; background: var(--good); }
  .split-cost { display: block; height: 100%; background: var(--bad); }
  .all-soft { margin-top: 22px; }
  .all-soft > summary { cursor: pointer; color: var(--accent); font-size: 13.5px; font-weight: 600; }
  .all-soft .soft-sum { font-size: 13.5px; margin: 10px 0 0; }
  .all-soft .group-head { font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin: 18px 0 8px; }
  .item.compact .name-block { margin-right: auto; min-width: 0; display: flex; flex-direction: column; }
  .all-soft .neutral-list { font-size: 13px; color: var(--muted); margin: 0; }
  .hard-ok { margin: 8px 0 10px; font-size: 13px; }
  .hard-ok > summary { cursor: pointer; color: var(--good); font-weight: 600; }
  @media (max-width: 480px) { .col-extra, .col-type { display: none; } }
  .item-body { padding: 0 8px 10px 16px; }
  .item .name { font-weight: 600; font-size: 14px; }
  .item .delta { font-variant-numeric: tabular-nums; font-weight: 700; font-size: 14px; white-space: nowrap; }
  .up .delta { color: var(--good); }
  .down .delta { color: var(--bad); }
  .desc { color: var(--muted); font-size: 13px; margin-top: 2px; }
  .examples, .occurrences { margin: 6px 0 0; padding-left: 18px; font-size: 13px; color: #45453f; }
  .examples li, .occurrences li { margin: 2px 0; }
  .occurrences .occ-count { color: var(--muted); font-variant-numeric: tabular-nums; }
  .more { color: var(--muted); font-size: 12px; font-style: italic; }

  /* -- rule description tooltip (icon shows description on hover/click) --
     Positioned as position:fixed (via JS, using the icon's own bounding
     rect) rather than absolute-relative-to-icon, so it can never be
     clipped by an ancestor's overflow — e.g. the horizontal-scroll
     wrapper around the full breakdown table. */
  .name-row { display: inline-flex; align-items: center; gap: 2px; }
  .info-wrap { display: inline-flex; vertical-align: middle; }
  .info-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 15px; height: 15px; margin-left: 5px; padding: 0; flex: none;
    border: none; border-radius: 50%; background: var(--line); color: var(--muted);
    font: 700 10px/1 -apple-system, BlinkMacSystemFont, sans-serif; cursor: pointer;
  }
  .info-icon:hover { background: var(--accent); color: #fff; }
  .info-icon:focus-visible { background: var(--accent); color: #fff; outline: 2px solid var(--accent); outline-offset: 2px; }
  .tooltip {
    position: fixed; z-index: 20;
    width: max-content; max-width: min(280px, 78vw);
    overflow-wrap: break-word; word-break: break-word;
    background: var(--ink); color: #fff; padding: 8px 10px; border-radius: 6px;
    font: 400 12.5px/1.4 -apple-system, BlinkMacSystemFont, sans-serif;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
    opacity: 0; visibility: hidden; transform: translateY(-4px); pointer-events: none;
    transition: opacity 0.12s ease, transform 0.12s ease;
  }
  .info-wrap:hover .tooltip,
  .info-wrap:focus-within .tooltip,
  .info-wrap.open .tooltip,
  .tooltip.show {
    opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto;
  }

  /* -- full breakdown table -- */
  details { margin-top: 26px; }
  summary { cursor: pointer; font-weight: 600; font-size: 14px; padding: 6px 0; }
  table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 14px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); font-weight: 600; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .kind { font-size: 11px; padding: 2px 7px; border-radius: 4px; background: #eeeee9; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .kind.hard { background: #eef4fa; color: var(--accent); }
  tr.violated td { background: #fdf4f3; }

  /* -- search difficulty (issue #34) -- */
  .search-stats { margin-top: 16px; }
  .search-stats > summary { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .difficulty-pill {
    font-size: 11px; padding: 2px 8px; border-radius: 10px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .difficulty-easy { background: #e8f6ee; color: var(--good); }
  .difficulty-moderate { background: #fdf6ea; color: var(--warn); }
  .difficulty-hard { background: #fdf0ee; color: var(--bad); }
  .search-stats .desc { margin-top: 6px; }

  /* -- rule contributions as a share of the season's movement (#34) -- */
  .contrib { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .contrib .share-track { display: block; width: 64px; height: 8px; background: #eeeee9; border-radius: 4px; overflow: hidden; }
  .contrib .share-fill { display: block; height: 100%; border-radius: 4px; background: var(--muted); }
  .contrib .share-text { font-weight: 700; font-size: 14px; min-width: 3.2em; text-align: right; }
  .contrib.gain .share-fill { background: var(--good); }
  .contrib.gain .share-text { color: var(--good); }
  .contrib.cost .share-fill { background: var(--bad); }
  .contrib.cost .share-text { color: var(--bad); }
  .raw { color: var(--muted); font-size: 12.5px; font-variant-numeric: tabular-nums; }
  @media (max-width: 480px) {
    .contrib { gap: 6px; }
    .contrib .share-track { width: 36px; }
    .contrib .share-text { min-width: 0; font-size: 13px; }
  }
  .how-scored { margin-top: 14px; }
  .how-scored > summary { cursor: pointer; color: var(--accent); font-size: 13px; }
  .how-body { margin-top: 8px; font-size: 13.5px; max-width: 720px; }
  .how-body p { margin: 0 0 8px; }

  /* -- fairness across teams -- */
  .fairness-row { margin: 14px 0 0; padding: 12px 14px; border: 1px solid var(--line); border-radius: 8px; }
  .fairness-row.flagged { border-color: #f0cf98; background: #fdf8ef; }
  .fairness-row .head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .fairness-row .fname { font-weight: 600; font-size: 13.5px; }
  .fairness-row .flag { font-size: 11.5px; color: var(--warn); font-weight: 700; }
  .fairness-bars { margin-top: 10px; display: flex; flex-direction: column; gap: 5px; }
  .fairness-bar { display: grid; grid-template-columns: 150px 1fr 28px; align-items: center; gap: 8px; font-size: 12.5px; }
  .fairness-bar .flabel { color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fairness-bar .ftrack { display: block; background: #eeeee9; border-radius: 4px; height: 8px; overflow: hidden; }
  .fairness-bar .ffill { display: block; background: var(--accent); height: 100%; border-radius: 4px; }
  .fairness-bar .fcount { text-align: right; font-variant-numeric: tabular-nums; color: var(--muted); }

  /* -- sticky bar: option summary, view toggle, filters, legend --
     Stacking order: bar (10) < tooltips (20). The legend popover lives inside the bar. */
  .controls {
    position: sticky; top: 0; z-index: 10;
    margin: 26px calc(-1 * var(--panel-pad)) 0; padding: 8px var(--panel-pad);
    background: var(--panel); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.06);
    display: grid; gap: 6px 14px; align-items: center;
    grid-template-columns: auto auto minmax(0, 1fr);
    grid-template-areas: "sum actions views" "filt filt filt";
  }
  .bar-summary { grid-area: sum; display: flex; align-items: baseline; gap: 8px; white-space: nowrap; min-width: 0; }
  .bar-opt { font-weight: 700; font-size: 14px; overflow: hidden; text-overflow: ellipsis; }
  .bar-score { font-weight: 700; font-size: 16px; font-variant-numeric: tabular-nums; }
  .bar-score small { font-size: 11.5px; font-weight: 400; color: var(--muted); }
  .bar-summary .badge { font-size: 10.5px; padding: 2px 8px; }
  .bar-actions { grid-area: actions; display: flex; gap: 6px; align-items: center; }
  .bar-btn {
    font: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer; white-space: nowrap;
    border: 1px solid var(--line); background: var(--panel); color: var(--ink);
    padding: 4px 10px; border-radius: 14px;
  }
  .bar-btn:hover, .bar-btn[aria-expanded="true"] { border-color: var(--accent); color: var(--accent); }
  .bar-btn:focus-visible, .chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .filters-toggle { display: none; }
  .bar-filters { grid-area: filt; display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
  .bar-fields { display: contents; }
  .bar-chips { display: flex; gap: 6px; flex-wrap: wrap; min-width: 0; }
  .chip {
    font: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer; max-width: 100%;
    border: 1px solid var(--accent); background: #eaf2f8; color: var(--accent);
    padding: 2px 10px; border-radius: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .chip:hover { background: var(--accent); color: #fff; }
  .chip[hidden] { display: none; }
  .jump-cal { margin-left: auto; align-self: center; }
  .legend-wrap { display: contents; }
  .legend-panel {
    position: absolute; left: var(--panel-pad); top: calc(100% + 6px); width: min(720px, calc(100% - 2 * var(--panel-pad)));
    max-height: min(70vh, 520px); overflow-y: auto; padding: 4px 14px 14px;
    background: var(--panel); border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }
  .legend-panel[hidden] { display: none; }
  .legend-panel h4 { margin: 12px 0 0; font-size: 12.5px; }
  .legend-panel .legend { margin-top: 8px; }
  .legend-panel .flag-legend { margin-top: 0; }
  .panel[data-current-view="month-calendar"] .legend-cards { display: none; }
  .view-toggle { grid-area: views; display: flex; gap: 6px; flex-wrap: wrap; justify-self: start; min-width: 0; max-width: 100%; }
  .view-btn {
    border: 1px solid var(--line); background: var(--panel); color: var(--ink);
    padding: 6px 12px; border-radius: 20px; cursor: pointer; font-size: 12.5px; font-weight: 600;
  }
  .view-short { display: none; }
  .view-btn.active { background: var(--ink); color: #fff; border-color: var(--ink); }
  .club-filter { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
  .club-filter select {
    font: inherit; padding: 5px 8px; border-radius: 6px; border: 1px solid var(--line);
    background: var(--panel); color: var(--ink);
  }

  .lens-filter select { max-width: 260px; }
  .lens-only { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); }
  .lens-only:has(input:disabled) { opacity: 0.55; }
  .lens-caption {
    margin-top: 12px; display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap;
    padding: 8px 12px; border-left: 3px solid var(--accent); background: #eaf2f8;
    border-radius: 0 6px 6px 0; font-size: 13px;
  }
  .lens-caption[hidden] { display: none; }
  .lens-text { flex: 1 1 320px; min-width: 0; }
  .lens-text b { font-weight: 700; }
  .lens-link {
    font: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer; white-space: nowrap;
    border: 1px solid var(--accent); color: var(--accent); background: var(--panel);
    padding: 2px 10px; border-radius: 14px;
  }
  .lens-link:hover { background: var(--accent); color: #fff; }
  .lens-link:focus-visible, .occ-row:focus-visible,
  .lens-select:focus-visible, .lens-only input:focus-visible, .club-select:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 2px;
  }
  .view-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* -- rule lens: what a rule's fixtures look like among the rest --
     Dimmed fixtures stay legible (faded, not hidden); hits get a ring or band
     so the state is not carried by colour alone. */
  .lens-dim { opacity: 0.5; }
  .fx.lens-hit, .day-row.lens-hit { box-shadow: 0 0 0 2px var(--accent); }
  .day-row.lens-hit { background: #eaf2f8; }
  .fx-row.lens-hit td { background: #eaf2f8; box-shadow: inset 0 2px 0 var(--accent), inset 0 -2px 0 var(--accent); }
  .flag.lens-rule { outline: 2px solid var(--ink); outline-offset: 1px; }
  .cal-day.lens-hit { border: 2px solid var(--accent); background: #eaf2f8; }
  .cal-day.lens-dim { opacity: 0.4; }
  .cal-hits {
    font-size: 10.5px; font-weight: 700; line-height: 1; padding: 2px 5px; border-radius: 8px;
    background: var(--accent); color: #fff;
  }
  /* Jump target: a ring that fades, so the eye finds the fixture after the scroll. */
  .flash { outline: 3px solid #d35400; outline-offset: 2px; animation: flash-fade 2.2s ease-out; }
  .fx-row.flash td { background: #fde9cf; }
  @keyframes flash-fade { 0% { background-color: #ffd9a8; } 100% { background-color: transparent; } }
  @media (prefers-reduced-motion: reduce) { .flash { animation: none; } }

  /* A rule's fixtures, listed under the scorecard entry that names it. */
  .rule-actions { margin: 2px 0 6px; }
  .rule-fixtures { margin-top: 6px; }
  details.fx-list { margin-top: 6px; }
  details.fx-list > summary { font-size: 12.5px; font-weight: 600; color: var(--accent); }
  .occ-summary { margin: 4px 0 6px; font-size: 12.5px; color: #45453f; }
  .occ-groups { max-height: 380px; overflow-y: auto; border: 1px solid var(--line); border-radius: 6px; background: #fcfcfb; }
  .occ-groups:focus-visible { outline: 2px solid var(--accent); }
  details.occ-group { margin: 0; border-bottom: 1px solid var(--line); }
  details.occ-group:last-child { border-bottom: none; }
  details.occ-group > summary { padding: 5px 10px; font-size: 13px; background: #f3f3ef; position: sticky; top: 0; }
  .occ-groups ul { list-style: none; margin: 0; padding: 0; }
  .occ-row {
    display: grid; grid-template-columns: 74px minmax(110px, 150px) 1fr auto; gap: 2px 10px; width: 100%;
    align-items: baseline; text-align: left; font: inherit; font-size: 12.5px; color: var(--ink);
    background: none; border: none; border-top: 1px solid var(--line); padding: 5px 10px; cursor: pointer;
  }
  li:first-child > .occ-row { border-top: none; }
  .occ-row:hover { background: #eaf2f8; }
  .occ-groups .occ-count { color: var(--muted); font-variant-numeric: tabular-nums; font-weight: 400; }
  .occ-date { color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .occ-fx { font-weight: 600; }
  .occ-detail { color: #45453f; min-width: 0; overflow-wrap: anywhere; }
  .occ-delta { font-variant-numeric: tabular-nums; font-weight: 700; white-space: nowrap; text-align: right; }
  .occ-delta.good { color: var(--good); }
  .occ-delta.cost, .occ-delta.broken { color: var(--bad); }
  .occ-delta.none { color: var(--muted); font-weight: 400; }
  .tooltip.show { pointer-events: none; }
  .tooltip .tt-hint { display: block; margin-top: 5px; color: #c9c9c4; font-size: 11.5px; }

  /* -- calendar -- */
  .cal-wrap { overflow-x: auto; }
  .view-pane[hidden] { display: none; }
  .comp { margin-top: 30px; }
  .comp h3 { font-size: 16px; margin: 0 0 2px; }
  .comp .meta { color: var(--muted); font-size: 13px; margin-bottom: 12px; }
  .round { border-top: 1px solid var(--line); padding: 10px 0; display: grid; grid-template-columns: 200px 1fr; gap: 14px; }
  .round .rlabel { font-size: 12px; color: var(--muted); }
  .round .rlabel b { display: block; color: var(--ink); font-size: 14px; }
  /* Round and week totals: the label's edge takes the net's colour, the text says the figure. */
  .round .rlabel.rl-good { border-left: 3px solid var(--good); padding-left: 8px; }
  .round .rlabel.rl-cost { border-left: 3px solid var(--warn); padding-left: 8px; }
  .rsum { margin-top: 3px; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .rsum .rnet { font-weight: 700; color: var(--ink); }
  .rsum .rnet.good { color: var(--good); }
  .rsum .rnet.cost { color: var(--warn-ink); }
  .rtag {
    display: inline-block; margin-left: 6px; padding: 0 6px; border: 1px solid var(--line); border-radius: 8px;
    font-size: 10.5px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted);
  }
  .fixtures { display: flex; flex-wrap: wrap; gap: 8px; }
  /* `gap` alone spaces every child of the card (date, tag, swatches, names,
     the "v" separator, the pair dot) evenly — issue #61 asked for more
     breathing room here, so this replaced a set of per-element margins that
     made the card read as one cramped run of text. */
  .fx {
    display: inline-flex; flex-direction: column; align-items: flex-start; gap: 5px;
    border: 1px solid var(--line); border-left: 4px solid var(--line); border-radius: 7px;
    padding: 7px 12px 7px 10px; font-size: 13px; background: #fcfcfb; white-space: nowrap;
  }
  .fx-main { display: inline-flex; align-items: center; gap: 5px; }
  .fx .d { color: var(--muted); font-variant-numeric: tabular-nums; }
  .fx .h { font-weight: 600; }
  .fx .vs { color: var(--muted); }
  /* Card edge by net points: green gains, amber costs, red a broken hard rule. */
  .edge-good { border-left-color: var(--good); }
  .edge-cost { border-left-color: var(--warn); }
  .edge-broken { border-left-color: var(--bad); }
  .fx.edge-good { background: #f1f9f4; }
  .fx.edge-cost { background: #fdf8ee; }
  .fx.edge-broken { background: #fdf0ee; }
  .fx-row td:first-child, .day-row { border-left: 4px solid transparent; }
  .fx-row.edge-good td:first-child, .day-row.edge-good { border-left-color: var(--good); }
  .fx-row.edge-cost td:first-child, .day-row.edge-cost { border-left-color: var(--warn); }
  .fx-row.edge-broken td:first-child, .day-row.edge-broken { border-left-color: var(--bad); }

  /* Scoring badges: one per rule a fixture triggers. Also the tooltip anchor. */
  .flags { display: flex; flex-wrap: wrap; gap: 4px; }
  .flag {
    font: 600 10.5px/1.5 -apple-system, BlinkMacSystemFont, sans-serif; letter-spacing: 0.01em;
    padding: 0 7px; border-radius: 9px; border: 1px solid transparent; cursor: pointer;
    white-space: nowrap; text-align: left; text-transform: none;
  }
  .flag-good { background: #e4f3ea; color: var(--good); border-color: #bfe0cc; }
  .flag-cost { background: #fbefd5; color: #8a5a06; border-color: #ecd199; }
  .flag-broken { background: var(--bad); color: #fff; }
  .flag:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .tooltip { white-space: normal; text-align: left; }
  .tooltip .tt-head { display: block; font-weight: 700; }
  .tooltip .tt-detail { display: block; margin-top: 3px; }
  .fx-row .flags { flex-wrap: wrap; min-width: 120px; }
  .comp-tag {
    /* Short names (e.g. "NM(m)") carry their own deliberate case, so no
       text-transform here — unlike a full competition name, which would
       read fine either way. */
    font-size: 10px; padding: 1px 6px; border-radius: 10px;
    background: var(--comp-bg, #eeeee9); color: var(--comp-fg, var(--muted)); letter-spacing: 0.03em;
  }
  /* Home = square, away = diamond, both filled with the club's own colour
     (data/clubs.yml). Fixed pixel sizes rather than a text glyph — a
     unicode glyph here previously rendered visibly larger than the
     surrounding text depending on the reader's font, which is what made
     some fixtures look like they had "bigger text" than others. */
  .swatch, .swatch-diamond, .swatch-neutral {
    display: inline-block; width: 8px; height: 8px;
    vertical-align: middle; flex: none; background: var(--club, var(--ink));
  }
  /* A European leg whose home/away is not yet confirmed. */
  .swatch-dim { opacity: 0.4; }
  .fx-row .swatch, .fx-row .swatch-diamond, .fx-row .swatch-neutral { margin-right: 5px; }
  .fx-row .muted { color: var(--muted); }
  .swatch { border-radius: 2px; }
  .swatch-diamond { border-radius: 1px; transform: rotate(45deg); }
  /* Cup final only: neutral ground, so neither the square (home) nor the
     diamond (away) marker applies. */
  .swatch-neutral { border-radius: 50%; }
  .edge-demo {
    display: inline-block; width: 22px; height: 14px; margin-right: 5px;
    border: 1px solid var(--line); border-left: 4px solid var(--line); border-radius: 4px;
    vertical-align: middle;
  }
  .edge-demo.edge-good { background: #f1f9f4; border-left-color: var(--good); }
  .edge-demo.edge-cost { background: #fdf8ee; border-left-color: var(--warn); }
  .edge-demo.edge-broken { background: #fdf0ee; border-left-color: var(--bad); }
  .flag-legend { margin: 10px 0 0; font-size: 12.5px; color: var(--muted); }
  .flag-legend ul { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 6px 24px; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); }
  .flag-legend li { display: flex; gap: 8px; align-items: baseline; }
  .flag-legend .flag { cursor: default; flex: none; }
  .legend { display: flex; gap: 16px; flex-wrap: wrap; font-size: 12.5px; color: var(--muted); margin: 14px 0 0; align-items: center; }
  footer { margin-top: 40px; color: var(--muted); font-size: 12.5px; }

  /* -- month calendar (issue #77) -- */
  .month { margin-top: 26px; }
  .month h4 { margin: 0 0 8px; font-size: 15px; }
  .month-grid { display: flex; flex-direction: column; gap: 3px; min-width: 420px; }
  .month-grid-row { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }
  .month-grid-head {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted);
    text-align: center; padding-bottom: 2px;
  }
  .cal-day {
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
    gap: 4px; min-height: 52px; padding: 6px 2px; border: 1px solid var(--line); border-radius: 6px;
    background: var(--panel); color: var(--ink); font: inherit; cursor: pointer;
  }
  .cal-day:hover, .cal-day:focus-visible { border-color: var(--accent); outline: none; }
  .cal-day.selected { border-color: var(--accent); background: #eaf2f8; }
  /* Days of the neighbouring months: space in the grid, nothing to tap. */
  .cal-day.cal-pad { border-color: transparent; background: none; }
  .cal-daynum { font-size: 12.5px; font-variant-numeric: tabular-nums; }
  .cal-dots { display: flex; gap: 3px; flex-wrap: wrap; justify-content: center; min-height: 8px; }
  .cal-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--comp-fg, var(--muted)); }
  .legend .cal-dot { margin-right: 5px; }
  .day-details {
    margin: 6px 0 4px; padding: 12px 14px; background: var(--panel);
    border: 1px solid var(--line); border-top: 3px solid var(--accent); border-radius: 8px;
  }
  .day-detail-empty { color: var(--muted); font-size: 13.5px; }
  .day-detail .rlabel { margin-bottom: 8px; }
  .day-detail .rlabel b { display: block; color: var(--ink); font-size: 14px; }
  .day-detail .fixtures { display: flex; flex-direction: column; }
  .day-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 13px; padding: 5px 0 5px 8px; border-bottom: 1px solid var(--line); }
  .day-row:last-child { border-bottom: none; }
  .day-row .vs { color: var(--muted); margin: 0 1px; }
  .day-row .flags { flex-basis: 100%; }
  .day-row .d { margin-left: auto; color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* The count and the net each sit on their own line, so a narrow cell wraps nowhere. */
  .cal-net { display: flex; flex-direction: column; align-items: center; font-size: 10.5px; line-height: 1.15; font-variant-numeric: tabular-nums; color: var(--muted); max-width: 100%; }
  .cal-count, .cal-value { white-space: nowrap; }
  .cal-value { font-weight: 600; }
  .cal-value.good { color: var(--good); }
  .cal-value.cost { color: var(--warn-ink); }

  /* Season strip: one button per round; each league row scrolls inside itself. */
  .season-strip { margin: 14px 0 0; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .season-strip[hidden] { display: none; }
  .strip-row { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 10px; align-items: center; margin-top: 6px; }
  .strip-name { font-size: 12.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .strip-caption { font-size: 12px; color: var(--muted); margin-bottom: 4px; }
  .strip-cells { display: flex; gap: 2px; min-width: 0; overflow-x: auto; padding: 8px 4px 4px 0; }
  .strip-cell {
    position: relative; flex: 1 1 0; min-width: 30px; max-width: 46px; display: flex; flex-direction: column; align-items: center; gap: 1px;
    padding: 3px 2px 4px; font: inherit; font-size: 11px; line-height: 1.2; color: var(--ink);
    background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--line); border-radius: 5px; cursor: pointer;
  }
  .strip-cell:hover { border-color: var(--accent); }
  .strip-cell:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .strip-cell.sc-good { border-left-color: var(--good); }
  .strip-cell.sc-cost { border-left-color: var(--warn); }
  .strip-cell.sc-cost .strip-net { color: var(--warn-ink); }
  .strip-cell:disabled { opacity: 0.4; cursor: default; }
  .strip-round { font-weight: 700; font-variant-numeric: tabular-nums; }
  .strip-net { font-size: 10.5px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .strip-cell.sc-good .strip-net { color: var(--good); }
  .strip-hard {
    position: absolute; top: -6px; right: -6px; min-width: 15px; height: 15px; padding: 0 3px; border-radius: 8px;
    background: var(--bad); color: #fff; font-size: 9.5px; font-weight: 700; line-height: 15px; text-align: center;
  }

  /* Combined list's score column, right-aligned so the signs line up. */
  .fx-score { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .fx-score.good { color: var(--good); font-weight: 600; }
  .fx-score.cost { color: var(--warn-ink); }

  /* -- club scope: the scorecard restated for one club -- */
  .scope-banner {
    display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; justify-content: space-between;
    margin: 18px 0 0; padding: 8px 12px; border-left: 3px solid var(--accent); background: #eaf2f8;
    border-radius: 0 6px 6px 0; font-size: 13px;
  }
  .scope-text { flex: 1 1 280px; min-width: 0; }
  .scope-clear {
    font: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer; white-space: nowrap;
    border: 1px solid var(--accent); color: var(--accent); background: var(--panel);
    padding: 2px 10px; border-radius: 14px;
  }
  .scope-clear:hover { background: var(--accent); color: #fff; }
  .scope-clear:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .scope-card .cols { margin-top: 14px; }
  .scope-breakdown { margin-top: 18px; }
  .scope-count { font-weight: 600; white-space: nowrap; }
  .scope-count[hidden] { display: none; }
  .lens-count { font-size: 12.5px; color: var(--muted); white-space: nowrap; }

  /* -- club timeline: a row per date, a lane per team -- */
  .tl-legend { margin-top: 8px; }
  .tl-choose { margin-top: 8px; }
  .tl-choices { display: flex; flex-wrap: wrap; gap: 6px; }
  .tl-club-btn {
    font: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer;
    border: 1px solid var(--accent); color: var(--accent); background: var(--panel);
    padding: 3px 11px; border-radius: 14px;
  }
  .tl-club-btn:hover { background: var(--accent); color: #fff; }
  .tl-club-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .tl-grid { --lanes: 2; margin-top: 12px; }
  .tl-head, .tl-row {
    display: grid; grid-template-columns: 96px repeat(var(--lanes), minmax(0, 1fr)); gap: 10px;
  }
  .tl-head { font-size: 11.5px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .tl-row { padding: 8px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .tl-row.tl-clash { background: #fbf1f0; }
  .tl-date { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; font-size: 12.5px; }
  .tl-tag {
    font-size: 11px; font-weight: 600; padding: 1px 6px; border-radius: 4px;
    background: #eeeee9; color: var(--ink); border: 1px solid var(--line);
  }
  .tl-tag-bad { background: var(--bad); border-color: var(--bad); color: #fff; }
  .tl-cell { min-width: 0; display: flex; flex-direction: column; gap: 5px; }
  .tl-cell:empty::before { content: "—"; color: var(--muted); font-size: 12.5px; }
  .tl-fx {
    display: block; min-width: 0; padding: 5px 7px; font-size: 12.5px;
    background: var(--panel); border: 1px solid var(--line); border-left: 4px solid transparent; border-radius: 6px;
  }
  .tl-fx.edge-good { border-left-color: var(--good); }
  .tl-fx.edge-cost { border-left-color: var(--warn); }
  .tl-fx.edge-broken { border-left-color: var(--bad); }
  .tl-top { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }
  .tl-ha { font-size: 10.5px; font-weight: 700; padding: 0 4px; border: 1px solid var(--muted); border-radius: 3px; color: var(--muted); }
  .tl-opp { font-weight: 600; overflow-wrap: anywhere; margin-top: 2px; }
  .tl-gap { font-size: 11.5px; color: var(--muted); margin-top: 1px; }
  .tl-fx .flags { margin-top: 4px; }

  @media print { .controls { position: static; box-shadow: none; } .legend-wrap, .filters-toggle, .back-to-score, .jump-cal { display: none; } }

  @media (max-width: 480px) {
    .round { grid-template-columns: 1fr; gap: 4px; }
    .fx { white-space: normal; max-width: 100%; }
    .fx-main { flex-wrap: wrap; }
    /* The list's seven columns do not fit; each row becomes a small card so the
       Rules badges are not scrolled out of sight. */
    .view-pane[data-view="combined-list"] table, .view-pane[data-view="combined-list"] tbody { display: block; }
    .view-pane[data-view="combined-list"] thead { display: none; }
    .fx-row {
      display: grid; grid-template-columns: 1fr auto 1fr; gap: 2px 8px; align-items: center;
      grid-template-areas: "date score comp" "home vs away" "venue venue venue" "rules rules rules";
      padding: 8px 0 8px 8px; border-bottom: 1px solid var(--line); border-left: 4px solid transparent;
    }
    .fx-row td { padding: 0; border: none; }
    .fx-row td:nth-child(1) { grid-area: date; }
    .fx-row td:nth-child(2) { grid-area: comp; justify-self: end; }
    .fx-row td:nth-child(3) { grid-area: home; }
    .fx-row td:nth-child(4) { grid-area: vs; }
    .fx-row td:nth-child(5) { grid-area: away; }
    .fx-row td:nth-child(6) { grid-area: venue; color: var(--muted); font-size: 12px; }
    .fx-row td:nth-child(7) { grid-area: rules; }
    .fx-row td:nth-child(7):empty { display: none; }
    /* No column header on a card, so the score carries its unit. */
    .fx-row td:nth-child(8) { grid-area: score; text-align: left; }
    .fx-row td.fx-score::after { content: " pts"; color: var(--muted); font-weight: 400; }
    .strip-row { grid-template-columns: 84px minmax(0, 1fr); }
    /* Phone: fixed-width cells that scroll; the fade says the row goes on. */
    .strip-cells {
      padding-right: 26px;
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 26px), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 26px), transparent);
    }
    .strip-cell { flex: 0 0 auto; width: 40px; max-width: none; }
    .cal-net { font-size: 9.5px; }
    .fx-row td:first-child { border-left: none; }
    .fx-row.lens-hit { background: #eaf2f8; box-shadow: inset 0 0 0 2px var(--accent); }
    .fx-row.lens-hit td { background: none; box-shadow: none; }
    .fx-row.edge-good { border-left-color: var(--good); }
    .fx-row.edge-cost { border-left-color: var(--warn); }
    .fx-row.edge-broken { border-left-color: var(--bad); }
    .fairness-bar { grid-template-columns: 110px 1fr 24px; }
    :root { --panel-pad: 12px; }
    .controls {
      padding: 6px 12px; gap: 4px 8px;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "sum actions" "views views" "filt filt";
    }
    .bar-opt { font-size: 12.5px; }
    .bar-score { font-size: 14px; }
    .bar-summary { gap: 5px; }
    .bar-summary .badge { text-transform: none; letter-spacing: 0; font-size: 11px; padding: 1px 6px; }
    .bar-actions { gap: 3px; }
    .bar-btn { padding: 3px 7px; font-size: 11.5px; }
    .bar-btn-text, .legend-toggle .caret { display: none; }
    .controls.filters-open .bar-chips { display: none; }
    .filters-toggle { display: inline-block; }
    /* Short labels so all four views fit one row. */
    .view-toggle { flex-wrap: nowrap; gap: 4px; width: 100%; }
    .view-btn { flex: 1 1 auto; padding: 4px 6px; font-size: 12px; white-space: nowrap; }
    .view-full { display: none; }
    .view-short { display: inline; }
    .bar-fields { display: none; }
    .controls.filters-open .bar-fields { display: grid; gap: 6px; width: 100%; }
    .club-filter { min-width: 0; display: grid; grid-template-columns: 96px minmax(0, 1fr); }
    .club-filter select, .lens-filter select { max-width: none; min-width: 0; width: 100%; }
    .occ-row { grid-template-columns: auto 1fr auto; }
    .occ-detail { grid-column: 1 / -1; }
    .month-grid { min-width: 0; }
    .cal-day { min-height: 40px; padding: 4px 1px; }
    .scope-banner { padding: 8px 10px; }
    .tl-head, .tl-row { grid-template-columns: 64px repeat(var(--lanes), minmax(0, 1fr)); gap: 6px; }
    .tl-fx { padding: 4px 5px; font-size: 12px; }
    .tl-date { font-size: 12px; }
    .tl-tag { font-size: 10px; }
  }
</style>
<style id="palette">
{{ palette_css }}
</style>
</head>
<body>
{% set ns = namespace(tooltip_id=0) %}
{# A rule's fixtures are listed by report.js from the fixture flags, so only a rule with some (`row.pinned`) gets a mount and a calendar link. #}
{# Share as signed text; a non-zero share that rounds to 0 reads "<1%", never a bare "0%" (#34). #}
{% macro share_text(row) %}
  {%- set pct = '%.0f'|format(row.share) -%}
  {%- if pct == '0' and row.total -%}
    {{ '+' if row.total > 0 else '−' }}&lt;1%
  {%- else -%}
    {%- if pct != '0' %}{{ '+' if row.total > 0 else '−' }}{% endif -%}
    {{ pct }}%
  {%- endif -%}
{% endmacro %}
{% macro contribution(row) %}
{% if row.share is not none %}
<span class="contrib {{ 'gain' if row.total > 0 else ('cost' if row.total < 0 else 'neutral') }}">
  <span class="share-track" aria-hidden="true"><span class="share-fill" style="width:{{ '%.1f'|format(row.share) }}%"></span></span>
  <span class="share-text">{{ share_text(row) }}</span>
</span>
{% else %}
<span class="delta">{{ row.count }} violation{{ '' if row.count == 1 else 's' }}</span>
{% endif %}
{% endmacro %}
{# One scorecard row: name with its one-line description and coverage, and the share (#34).
   Full rows open onto the detail; compact rows (the all-rules list) only repeat the summary,
   so each rule keeps one set of fixture hooks. #}
{% macro rule_row(row, kind, ns, compact=false) %}
{% if compact %}
<div class="item {{ kind }} compact">
  <div class="top">
{% else %}
<details class="item {{ kind }}"{% if row.pinned %} data-rule="{{ row.id }}"{% endif %}>
  <summary class="top">
{% endif %}
    <span class="name-block">
      <span class="name-row">
        <span class="name">{{ row.name }}</span>
        {% set ns.tooltip_id = ns.tooltip_id + 1 %}
        <span class="info-wrap">
          <button type="button" class="info-icon" aria-label="{{ row.name }} description" aria-describedby="tt-{{ ns.tooltip_id }}">i</button>
          <span class="tooltip" id="tt-{{ ns.tooltip_id }}" role="tooltip">{{ row.description }}</span>
        </span>
      </span>
      <span class="rule-desc">{{ row.description }}</span>
      {% if row.coverage %}<span class="coverage">{{ row.coverage.achieved }} of {{ row.coverage.opportunities }} {{ row.coverage.unit }} ({{ '%.0f'|format(row.coverage.pct) }}%)</span>{% endif %}
    </span>
    {{ contribution(row) }}
{% if compact %}
  </div>
</div>
{% else %}
  </summary>
  <div class="item-body">
    {% if row.share is not none %}<div class="desc">Raw score change <span class="raw">{{ '%+.1f'|format(row.total) }}</span></div>{% endif %}
    <div class="rule-actions">{{ lens_link(row) }}</div>
    {% if row.pinned %}<div class="rule-fixtures"></div>{% endif %}
    {% if row.occurrences %}
    {% if row.pinned %}<div class="desc">Other events, not tied to one fixture:</div>{% endif %}
    <ul class="occurrences">
      {% for occ in row.occurrences %}<li>{{ occ.label }} <span class="occ-count">×{{ occ.count }}</span></li>{% endfor %}
    </ul>
    {% elif not row.pinned %}
    <div class="desc">×{{ row.count }}</div>
    {% endif %}
  </div>
</details>
{% endif %}
{% endmacro %}
{% macro lens_link(row) %}{% if row.pinned %}<button type="button" class="lens-link" data-rule="{{ row.id }}">Show in calendar</button>{% else %}<span class="desc">Not tied to one fixture, so nothing to show in the calendar.</span>{% endif %}{% endmacro %}
{% macro fixture_list(row) %}{% if row.pinned %}<details class="fx-list" data-rule="{{ row.id }}"><summary>{{ row.pinned }} fixture{{ '' if row.pinned == 1 else 's' }}, by team</summary><div class="rule-fixtures"></div></details>{% endif %}{% endmacro %}
<div class="wrap">

<header>
  <h1>{{ title }}</h1>
  <div class="sub">
    {{ season.start.strftime('%d %B %Y') }} – {{ season.end.strftime('%d %B %Y') }}
    · solver <b>{{ result.solver }}</b>
    {% if result.iterations %}· {{ '{:,}'.format(result.iterations) }} iterations{% endif %}
    · {{ '%.1f'|format(result.elapsed_s) }}s
  </div>
</header>

{% if result.notes %}
<div class="notes">
  {% for note in result.notes %}<div>{{ note }}</div>{% endfor %}
</div>
{% endif %}

{% if warnings %}
<div class="warnings">
  <div style="font-weight:700;margin-bottom:4px">Coverage notes</div>
  {% for warning in warnings %}<div>⚠ {{ warning }}</div>{% endfor %}
</div>
{% endif %}

{% if season_exclusions %}
<details>
  <summary>
    Season exclusions
    <span style="font-weight:400;color:var(--muted)">
      · {{ season_exclusions|length }} entr{{ 'y' if season_exclusions|length == 1 else 'ies' }}
    </span>
  </summary>
  <div class="item-body">
    {% for entry in season_exclusions %}
    <div class="desc">
      {{ entry.start.strftime('%d %b %Y') }}{% if entry.end != entry.start %} – {{ entry.end.strftime('%d %b %Y') }}{% endif %}
      {%- if entry.venue_label %} ({{ entry.venue_label }}){% endif %}
      {%- if entry.reason %} — {{ entry.reason }}{% endif %}
    </div>
    {% endfor %}
  </div>
</details>
{% endif %}

{% if playoff_views %}
<details>
  <summary>
    Play-off weeks
    <span style="font-weight:400;color:var(--muted)">
      · dates reserved after or between the league rounds
    </span>
  </summary>
  <div class="item-body">
    {% for view in playoff_views %}
    <div class="desc">
      <strong>{{ view.competition }}</strong> · {{ view.label }}
      {%- if not view.reserves_league %} (other division's teams){% endif %}
      · {% for d in view.dates %}{{ d.date.strftime('%a %d %b %Y') }} (week {{ d.iso_week }}){{ ', ' if not loop.last }}{% endfor %}
    </div>
    {% endfor %}
  </div>
</details>
{% endif %}

{% if slot_views %}
<details>
  <summary>
    Round slots
    <span style="font-weight:400;color:var(--muted)">
      · {% for view in slot_views %}{{ view.rounds }} rounds in {{ view.candidates }} candidate slots{% if view.overlapping %} ({{ view.overlapping }} overlap a weekend){% endif %}{{ ', ' if not loop.last }}{% endfor %}
    </span>
  </summary>
  <div class="item-body">
    {% for view in slot_views %}
    <div class="desc" style="font-weight:700;margin-top:8px">{{ view.name }}</div>
    <div class="desc">
      {{ '{:,}'.format(view.combinations) }} ways to pick compatible slots; per-match dates
      ~10<sup>{{ '%.0f'|format(view.dates_log10) }}</sup> within the slots' own days.
    </div>
    {% for row in view.rows %}
    <div class="desc">
      R{{ row.round }} · {{ row.kind }} ·
      {{ row.start.strftime('%d %b') }}{% if row.end != row.start %} – {{ row.end.strftime('%d %b') }}{% endif %}
      · default {{ row.default_day.strftime('%a %d %b') }}
      {%- if row.clashes %} · ⚠ clashes: {{ row.clashes|join(', ') }}{% endif %}
    </div>
    {% endfor %}
    {% endfor %}
  </div>
</details>
{% endif %}

{% if search_stats %}
<details class="search-stats">
  <summary>
    How hard was this to schedule?
    <span class="difficulty-pill difficulty-{{ search_stats.difficulty }}">{{ search_stats.difficulty }}</span>
    <span style="font-weight:400;color:var(--muted)">
      · {{ '{:,}'.format(search_stats.investigated) }} scenarios investigated ·
      {{ '%.0f'|format(search_stats.feasible_pct) }}% viable
    </span>
  </summary>
  <div class="item-body">
    <div class="desc">{{ search_stats.difficulty_label }}</div>
    <div class="desc">
      {{ '{:,}'.format(search_stats.feasible) }} scenario{{ '' if search_stats.feasible == 1 else 's' }} came out viable,
      {{ '{:,}'.format(search_stats.hard_violation_scenarios) }} hit at least one hard-rule violation
      ({{ '%.0f'|format(search_stats.hard_violation_pct) }}% of everything tried).
    </div>
    {% if search_stats.breakdown %}
    <div style="font-weight:700;margin:14px 0 6px;font-size:13px">Where the dead ends came from</div>
    <div class="fairness-bars">
      {% for row in search_stats.breakdown %}
      <div class="fairness-bar" title="{{ row.description }}">
        <span class="flabel">{{ row.name }}</span>
        <span class="ftrack"><span class="ffill" style="width:{{ row.pct }}%"></span></span>
        <span class="fcount">{{ '{:,}'.format(row.count) }}</span>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</details>
{% endif %}

{% if comparison %}
<section class="compare" aria-labelledby="compare-title">
  <h2 id="compare-title">Compare the {{ options|length }} options</h2>
  <p class="desc">Each rule row is the soft points that rule adds; higher is better. The score row is the 0–100 result. The best value on a row is shaded and marked “best”; a row where every option is level is left unmarked.</p>
  <div class="cmp-wrap">
    <table class="cmp">
      <thead>
        <tr>
          <th scope="col" class="cmp-measure"><span class="sr-only">Measure</span></th>
          {% for col in comparison.columns %}
          <th scope="col">
            <button type="button" class="cmp-open" data-option="{{ col.index }}">{{ col.label }}</button>
            {% if col.seed %}<span class="cmp-seed">seed {{ col.seed }}</span>{% endif %}
            {% if col.tag %}<span class="cmp-tag"><span class="cmp-tag-long">{{ col.tag }}</span><span class="cmp-tag-short">{{ col.tag_short }}</span></span>{% endif %}
            <div class="cmp-what">{{ col.summary }}</div>
          </th>
          {% endfor %}
        </tr>
      </thead>
      {% for section in comparison.sections %}
      <tbody>
        <tr class="cmp-section"><th scope="rowgroup" colspan="{{ comparison.columns|length + 1 }}">{{ section.title }}</th></tr>
        {% for row in section.rows %}
        <tr>
          <th scope="row" class="cmp-measure">{{ row.label }}</th>
          {% for cell in row.cells %}
          <td class="cmp-cell{% if cell.best %} is-best{% endif %}">
            <span class="cmp-val">{{ cell.text }}</span>{% if cell.best %}<span class="cmp-best">best</span>{% endif %}
            {% if cell.sub %}<span class="cmp-sub">{{ cell.sub }}</span>{% endif %}
          </td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
      {% endfor %}
    </table>
  </div>
  {% if comparison.diffs %}
  {% if comparison.quiet %}
  <p class="desc cmp-quiet">No effect in any option: {{ comparison.quiet|join(', ') }}.</p>
  {% endif %}
  <ul class="cmp-phone-summary">
    {% for col in comparison.columns %}
    <li><b>{{ col.label }}</b> {{ col.summary }}</li>
    {% endfor %}
  </ul>
  <div class="cmp-diffs">
    {% for diff in comparison.diffs %}
    <details class="cmp-diff">
      <summary>{{ diff.label }}: {{ diff.count }} of {{ diff.total }} league fixtures differ from {{ comparison.baseline }}</summary>
      <p class="desc">{{ diff.breakdown }}</p>
      {% if diff.fixtures %}
      <ul class="cmp-list">
        {% for item in diff.fixtures %}
        <li><span class="cmp-date">{{ item.date }}</span>{{ item.fixture }} <span class="desc">({{ item.detail }})</span></li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if diff.more %}<div class="more">…and {{ diff.more }} more</div>{% endif %}
    </details>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endif %}

<div class="tabs" role="tablist">
  {% for option in options %}
  <button class="tab" role="tab" data-panel="panel-{{ loop.index }}"
          aria-selected="{{ 'true' if loop.first else 'false' }}">
    {{ option.label }}{% if option.seed %}<span class="tab-seed">seed {{ option.seed }}</span>{% endif %}{% if option.tag %}<span class="tab-tag">{{ option.tag }}</span>{% endif %}<span class="score">{{ option.points_text }}</span>
  </button>
  {% endfor %}
</div>

{% for option in options %}
<section class="panel" id="panel-{{ loop.index }}" role="tabpanel" {% if not loop.first %}hidden{% endif %}>
{# Panels other than the first stay inert in a <template> until their tab is opened (#42). #}
{% if not loop.first %}<template>{% endif %}

  <div class="scoreline">
    <div class="total">{{ option.points_text }}<small>/ 100</small></div>
    {% if option.feasible %}
      <span class="badge ok">feasible · 0 hard violations</span>
    {% else %}
      <span class="badge fail">{{ option.hard_violations }} hard violation{{ '' if option.hard_violations == 1 else 's' }}</span>
    {% endif %}
    <button type="button" class="bar-btn jump-cal">Jump to calendar ↓</button>
  </div>

  <details class="how-scored">
    <summary>How is this scored?</summary>
    <div class="how-body">
      {% set sc = option.scoring %}
      {% if sc.feasible %}
      <p>With no hard-rule violations the score is 20 + 80 × s, where s = 1 ÷ (1 + e^−(soft per match ÷ {{ '%g'|format(sc.soft_scale) }})). This schedule has {{ '%.1f'|format(sc.raw_soft) }} raw soft points over {{ sc.num_matches }} match{{ '' if sc.num_matches == 1 else 'es' }}, {{ '%.2f'|format(sc.soft_per_match) }} per match, so s = {{ '%.3f'|format(sc.saturation) }} and the score is {{ '%.1f'|format(sc.points) }}, shown as {{ option.points_text }}.</p>
      <p>Soft points are scored per match, so seasons of different sizes compare fairly. Per match, 0 gives {{ '%.0f'|format(sc.example_zero) }}; about {{ '%g'|format(sc.example_per_match) }} gives {{ '%.0f'|format(sc.example_points) }}; more keeps helping, with diminishing returns.</p>
      {% else %}
      <p>{{ sc.hard_violations }} hard-rule violation{{ '' if sc.hard_violations == 1 else 's' }} cap the score at 20 and shrink it with each one: 20 × e^(−0.25 × {{ sc.hard_violations }}) = {{ '%.1f'|format(sc.points) }}, shown as {{ option.points_text }}. Fix the broken rules below before comparing the soft rules.</p>
      {% endif %}
      <p>Each rule's bar is its share of the season's total soft movement: the absolute totals of all soft rules add up to {{ '%.1f'|format(sc.gross) }} points here. A green + adds points and a red − takes them away. Shares compare rules with each other; they are not points on the 0–100 scale.</p>
    </div>
  </details>

  <div class="headlines">
    {% for headline in option.headlines %}
    <div class="headline">
      <div class="v">{{ headline.value }}</div>
      <div class="l">{{ headline.label }}</div>
    </div>
    {% endfor %}
  </div>

  {% if option.hard_violation_detail %}
  <div class="hardbox">
    <h3>Broken hard rules — this schedule is not usable as-is</h3>
    {% for row in option.hard_violation_detail %}
    <div class="item down">
      <div class="top">
        <span class="name-row">
          <span class="name">{{ row.name }}</span>
          {% set ns.tooltip_id = ns.tooltip_id + 1 %}
          <span class="info-wrap">
            <button type="button" class="info-icon" aria-label="{{ row.name }} description" aria-describedby="tt-{{ ns.tooltip_id }}">i</button>
            <span class="tooltip" id="tt-{{ ns.tooltip_id }}" role="tooltip">{{ row.description }}</span>
          </span>
        </span>
        <span class="delta">{{ row.count }} violation{{ '' if row.count == 1 else 's' }}</span>
      </div>
      <div class="rule-actions">{{ lens_link(row) }}</div>
      {{ fixture_list(row) }}
      {% if row.examples %}
      <ul class="examples">{% for example in row.examples %}<li>{{ example }}</li>{% endfor %}</ul>
      {% if row.more %}<div class="more">…and {{ row.more }} more</div>{% endif %}
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="scope-banner" hidden>
    <span class="scope-text"></span>
    <span class="scope-count" aria-live="polite" hidden></span>
    <button type="button" class="chip scope-clear">All clubs</button>
  </div>

  <div class="cols season-part">
    <div class="col">
      <h3>{{ 'Every upside' if option.full else 'Biggest upsides' }}</h3>
      {% for row in option.upsides %}{{ rule_row(row, 'up', ns) }}
      {% else %}
      <div class="desc">Nothing scored positively.</div>
      {% endfor %}
    </div>

    <div class="col">
      <h3>{{ 'Every problem (including the hard rules above)' if option.full else 'Biggest problems' }}</h3>
      {% for row in option.problems %}{{ rule_row(row, 'down', ns) }}
      {% else %}
      <div class="desc">Nothing scored negatively.</div>
      {% endfor %}
    </div>
  </div>

  {% set soft = option.soft %}
  <details class="season-part all-soft">
    <summary>Show all {{ soft.count }} soft rules: helping, hurting, neutral</summary>
    <p class="soft-sum">Helped by <b class="gain-text">{{ '%+.1f'|format(soft.helped)|replace('-', '−') }}</b>, hurt by <b class="cost-text">{{ '%+.1f'|format(soft.hurt)|replace('-', '−') }}</b>, net <b>{{ '%+.1f'|format(soft.net)|replace('-', '−') }}</b>.</p>
    <div class="split-bar" aria-hidden="true"><span class="split-gain" style="width:{{ '%.1f'|format(soft.gain_pct) }}%"></span><span class="split-cost" style="width:{{ '%.1f'|format(100 - soft.gain_pct) }}%"></span></div>
    <p class="desc">The gains and costs together are the rules’ gross movement of {{ '%.1f'|format(soft.helped - soft.hurt) }} points; the net is the raw soft score in the explanation above.</p>
    <h4 class="group-head">Helping ({{ soft.helping|length }})</h4>
    {% for row in soft.helping %}{{ rule_row(row, 'up', ns, true) }}{% else %}<div class="desc">None.</div>{% endfor %}
    <h4 class="group-head">Hurting ({{ soft.hurting|length }})</h4>
    {% for row in soft.hurting %}{{ rule_row(row, 'down', ns, true) }}{% else %}<div class="desc">None.</div>{% endfor %}
    <h4 class="group-head">Neutral, zero or did not apply ({{ soft.neutral|length }})</h4>
    {% if soft.neutral %}<p class="neutral-list">{{ soft.neutral|join(', ') }}</p>{% else %}<div class="desc">None.</div>{% endif %}
  </details>

  {# With a club selected, report.js draws the club's upsides, problems and breakdown here. #}
  <div class="scope-card"></div>

  <details class="season-part">
    <summary>Full score breakdown — every rule</summary>
    <div class="cal-wrap">
    {% set satisfied = option.breakdown|selectattr('kind', 'equalto', 'hard')|rejectattr('count')|list %}
    {% if satisfied %}
    <details class="hard-ok">
      <summary>{{ satisfied|length }} hard rule{{ '' if satisfied|length == 1 else 's' }} satisfied ✓</summary>
      <p class="desc">{{ satisfied|map(attribute='name')|join(', ') }}</p>
    </details>
    {% endif %}
    <table>
      <thead>
        <tr><th>Rule</th><th>Type</th><th class="num">Contribution</th><th class="num">Events</th><th class="col-extra">Examples</th></tr>
      </thead>
      <tbody>
      {% for row in option.breakdown if row.kind == 'soft' or row.count %}
        <tr {% if row.kind == 'hard' and row.count %}class="violated"{% endif %}>
          <td>
            <span class="name-row">
              <b>{{ row.name }}</b>
              {% set ns.tooltip_id = ns.tooltip_id + 1 %}
              <span class="info-wrap">
                <button type="button" class="info-icon" aria-label="{{ row.name }} description" aria-describedby="tt-{{ ns.tooltip_id }}">i</button>
                <span class="tooltip" id="tt-{{ ns.tooltip_id }}" role="tooltip">{{ row.description }}</span>
              </span>
            </span>
            {% if row.coverage %}<div class="coverage">{{ row.coverage.achieved }} of {{ row.coverage.opportunities }} {{ row.coverage.unit }} ({{ '%.0f'|format(row.coverage.pct) }}%)</div>{% endif %}
          </td>
          <td><span class="kind {{ row.kind }}">{{ row.kind }}</span></td>
          <td class="num">{% if row.share is not none %}{{ contribution(row) }}<div class="raw">{{ '%+.1f'|format(row.total) }}</div>{% else %}{{ '%+.1f'|format(row.total) if row.total else '—' }}{% endif %}</td>
          <td class="num">{{ row.count }}</td>
          <td class="col-extra">
            {% if row.pinned %}<div class="rule-actions">{{ lens_link(row) }}</div>{{ fixture_list(row) }}{% endif %}
            {% if row.examples %}
            <ul class="examples" style="margin:0;padding-left:16px">
              {% for example in row.examples %}<li>{{ example }}</li>{% endfor %}
            </ul>
            {% if row.more %}<span class="more">…and {{ row.more }} more</span>{% endif %}
            {% elif not row.pinned %}—{% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  </details>

  {% if option.fairness %}
  <details>
    <summary>Fairness across teams — is any one team favoured or penalised?</summary>
    <div class="desc" style="margin-top:8px">
      Per-rule counts for every team (or, for the two club-coupling rules,
      every dual club). A rule flagged ⚠ has a wider gap between its
      best- and worst-treated team than the rule's own average — worth a
      look before this schedule is accepted.
    </div>
    {% for row in option.fairness %}
    <div class="fairness-row {{ 'flagged' if row.flagged }}">
      <div class="head">
        <span class="fname">{{ row.name }}</span>
        {% if row.flagged %}<span class="flag">⚠ uneven — {{ row.min }}–{{ row.max }} across entries</span>{% endif %}
      </div>
      <div class="desc">{{ row.description }}</div>
      <div class="fairness-bars">
        {% for entry in row.entries %}
        <div class="fairness-bar">
          <span class="flabel" title="{{ entry.label }}">{{ entry.label }}</span>
          <span class="ftrack"><span class="ffill" style="width:{{ (100 * entry.count / row.max) if row.max else 0 }}%"></span></span>
          <span class="fcount">{{ entry.count }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </details>
  {% endif %}

  <noscript><div class="warnings">This report draws its fixtures with JavaScript; enable it to see them.</div></noscript>

  <div class="controls">
    <div class="bar-summary">
      <span class="bar-opt">{{ option.label }}</span>
      <span class="bar-score">{{ option.points_text }}<small>/100</small></span>
      {% if option.feasible %}
        <span class="badge ok">feasible</span>
      {% else %}
        <span class="badge fail">{{ option.hard_violations }} hard violation{{ '' if option.hard_violations == 1 else 's' }}</span>
      {% endif %}
    </div>
    <div class="bar-actions">
      <button type="button" class="bar-btn back-to-score" aria-label="Back to score"><span aria-hidden="true">↑</span><span class="bar-btn-text"> Score</span></button>
      <div class="legend-wrap">
        <button type="button" class="bar-btn legend-toggle" aria-expanded="false" aria-controls="legend-{{ loop.index }}">Legend<span class="caret"> ▾</span></button>
        <div class="legend-panel" id="legend-{{ loop.index }}" hidden>
          <div class="legend-cards">
            <h4>Fixture cards</h4>
            <div class="legend">
              <span><span class="edge-demo edge-good" aria-hidden="true"></span>green edge: nets +{{ '%g' % tint_good }} or more</span>
              <span><span class="edge-demo edge-cost" aria-hidden="true"></span>amber edge: costs {{ '%g' % tint_cost }} or more</span>
              <span><span class="edge-demo edge-broken" aria-hidden="true"></span>red edge: breaks a hard rule</span>
              <span><span class="swatch" style="margin-right:5px" aria-hidden="true"></span>square = home club colour</span>
              <span><span class="swatch-diamond" style="margin-right:5px" aria-hidden="true"></span>diamond = away club colour</span>
              <span><span class="swatch-neutral" style="margin-right:5px" aria-hidden="true"></span>circle = cup final, neutral ground</span>
              <span>round, week and day totals: net points of the badges on the games shown; midweek means all games Mon–Thu</span>
            </div>
          </div>
          {% if flag_legend %}
          <div class="flag-legend">
            <h4>What the badges mean (tap any badge on a fixture for details)</h4>
            <ul>
              {% for rule in flag_legend %}
              <li>
                <span>{% for polarity in rule.polarities %}<span class="flag flag-{{ polarity }}" style="margin-right:4px">{{ rule.label }}</span>{% endfor %}</span>
                <span>{{ rule.description }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>
          {% endif %}
        </div>
      </div>
      <button type="button" class="bar-btn filters-toggle" aria-expanded="false" aria-controls="filters-{{ loop.index }}">Filters</button>
    </div>
    <div class="view-toggle">
      <button type="button" class="view-btn" data-view="by-competition" aria-label="By competition"><span class="view-full">By competition</span><span class="view-short" aria-hidden="true">Rounds</span></button>
      <button type="button" class="view-btn" data-view="month-calendar" aria-label="Month calendar"><span class="view-full">Month calendar</span><span class="view-short" aria-hidden="true">Month</span></button>
      <button type="button" class="view-btn" data-view="combined-calendar" aria-label="Combined calendar"><span class="view-full">Combined · calendar</span><span class="view-short" aria-hidden="true">Calendar</span></button>
      <button type="button" class="view-btn" data-view="combined-list" aria-label="Combined list"><span class="view-full">Combined · list</span><span class="view-short" aria-hidden="true">List</span></button>
      <button type="button" class="view-btn" data-view="club-timeline" aria-label="Club timeline"><span class="view-full">Club timeline</span><span class="view-short" aria-hidden="true">Timeline</span></button>
    </div>
    <div class="bar-filters">
      <div class="bar-fields" id="filters-{{ loop.index }}">
        <label class="club-filter">
          Club
          <select class="club-select">
            <option value="">All clubs</option>
            {% for club in all_clubs %}
            <option value="{{ club.id }}">{{ club.name }}</option>
            {% endfor %}
          </select>
        </label>
        {# Shown by report.js for a dual club only: all of its fixtures, or one team's. #}
        <label class="club-filter team-filter" hidden>
          Team
          <select class="team-select"><option value="">All</option></select>
        </label>
        {# Options are filled in by report.js from the rules this option has fixtures for. #}
        <label class="club-filter lens-filter">
          Highlight rule
          <select class="lens-select"><option value="">No rule</option></select>
        </label>
        <label class="lens-only"><input type="checkbox" class="lens-only-box" disabled> Only show matching</label>
      </div>
      <div class="bar-chips">
        <button type="button" class="chip club-clear" hidden><span class="chip-text"></span> <span aria-hidden="true">×</span></button>
        <button type="button" class="chip team-clear" hidden><span class="chip-text"></span> <span aria-hidden="true">×</span></button>
        <button type="button" class="chip lens-clear" hidden><span class="chip-text"></span> <span aria-hidden="true">×</span></button>
      </div>
    </div>
  </div>

  <div class="lens-caption" hidden>
    <span class="lens-text" role="status"></span>
    <span class="lens-count" aria-live="polite" hidden></span>
  </div>

  {# Drawn by report.js for the views that list rounds. #}
  <div class="season-strip" role="group" aria-label="Season overview: one button per round" hidden></div>

  {# Fixtures are drawn into each `.pane-body` by report.js from #report-data. #}
  <div class="cal-wrap view-pane" data-view="by-competition" hidden>
    <div class="pane-body"></div>
  </div>

  <div class="cal-wrap view-pane" data-view="month-calendar" hidden>
    <div class="desc" style="margin-top:8px">
      One dot per competition with something on that day (a match, cup round, or European leg) —
      tap a day to list its games under that week. A figure under a day is the net rule points of its games shown.
    </div>
    {% if option.calendar_legend %}
    <div class="legend">
      {% for comp in option.calendar_legend %}
      <span><span class="cal-dot {{ comp.cls }}" aria-hidden="true"></span><b>{{ comp.short }}</b> {{ comp.name }}</span>
      {% endfor %}
    </div>
    {% endif %}
    <div class="pane-body"></div>
  </div>

  <div class="cal-wrap view-pane" data-view="combined-calendar" hidden>
    <div class="desc" style="margin-top:8px">
      Every league's matches and every cup's per-team round dates, interleaved
      by date. A cup round has no fixture-level pairing yet (the opponent is
      drawn closer to each round), so those cards show "v TBD" — see
      "By competition" for the venue rule behind each round.
    </div>
    <div class="pane-body"></div>
  </div>

  <div class="cal-wrap view-pane" data-view="combined-list" hidden>
    <div class="pane-body"></div>
  </div>

  <div class="cal-wrap view-pane" data-view="club-timeline" hidden>
    <div class="pane-body"></div>
  </div>

{% if not loop.first %}</template>{% endif %}
</section>
{% endfor %}

<footer>
  Generated by terminliste. Club, venue and league data is assembled from public sources
  and marked <code>verified: false</code> — check <code>data/</code> before using this for anything real.
</footer>

</div>

<script type="application/json" id="report-data">{{ report_data_json }}</script>
<script>
{{ client_js }}
</script>
</body>
</html>
